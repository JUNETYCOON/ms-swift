{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stage1:s1-udf:manifest:1.0.0",
  "title": "Stage1 Universal Dataset Format manifest",
  "type": "object",
  "required": ["format", "schema_version", "dataset", "record_files"],
  "properties": {
    "format": {"const": "s1-udf"},
    "schema_version": {"const": "1.0.0"},
    "dataset": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "description": {"type": "string"},
        "homepage": {"type": "string"},
        "license": {"type": "string"},
        "citation": {"type": "string"},
        "revision": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "record_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "format"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "format": {"enum": ["jsonl", "json", "parquet"]},
          "split": {"type": "string"},
          "count": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "task_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "splits": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "taxonomies": {"type": "array", "items": {"type": "object"}},
    "coordinate_conventions": {"type": "array", "items": {"type": "object"}},
    "source_schemas": {"type": "array", "items": {"type": "object"}},
    "grouping": {
      "type": "object",
      "required": ["field", "semantics"],
      "properties": {
        "field": {"const": "group_id"},
        "semantics": {"type": "string", "minLength": 1},
        "identity_fields": {"type": "array", "items": {"type": "string"}},
        "seed": {"type": "integer"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "provenance": {"type": "object"},
    "statistics": {"type": "object"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
