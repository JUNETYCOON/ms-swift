MEDIA_TOKEN_RE = re.compile(r'<(image|video)>', re.IGNORECASE)
NUMBER_RE = r'[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?'
LEGACY_BOX_RE = re.compile(r'<\|box_start\|>(.*?)<\|box_end\|>', re.DOTALL)
TAGGED_BOX_RE = re.compile(r'<(?:bbox|box)>(.*?)</(?:bbox|box)>', re.DOTALL | re.IGNORECASE)
INLINE_BOX_RE = re.compile(rf'[\[(]\s*{NUMBER_RE}\s*,\s*{NUMBER_RE}\s*,\s*{NUMBER_RE}\s*,\s*{NUMBER_RE}\s*[\])]')
PAIR_BOX_RE = re.compile(rf'\(\s*({NUMBER_RE})\s*,\s*({NUMBER_RE})\s*\)\s*,?\s*'
                         rf'\(\s*({NUMBER_RE})\s*,\s*({NUMBER_RE})\s*\)')
KEYED_BOX_RE = re.compile(
    rf'(?:bbox_2d|bounding_box|bbox|box)\s*["\']?\s*[:=]\s*'
    rf'[\[(]\s*({NUMBER_RE})\s*,\s*({NUMBER_RE})\s*,\s*'
    rf'({NUMBER_RE})\s*,\s*({NUMBER_RE})\s*[\])]', re.IGNORECASE)
PLAIN_BOX_RE = re.compile(rf'^\s*[\[(]\s*({NUMBER_RE})\s*,\s*({NUMBER_RE})\s*,\s*'
                          rf'({NUMBER_RE})\s*,\s*({NUMBER_RE})\s*[\])]\s*$')
ANSWER_RE = re.compile(r'<answer>(.*?)</answer>', re.DOTALL | re.IGNORECASE)
THINK_END_RE = re.compile(r'</think>', re.IGNORECASE)
DESCRIPTION_TOKEN_RE = re.compile(
    r'[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]|[\u3040-\u30ff]|[^\W_]+(?:[\'’.-][^\W_]+)*',
    re.UNICODE)
DESCRIPTION_PROMPT_RE = re.compile(r'\b(?:describe|description|caption)\b', re.IGNORECASE)
OBJECT_REF_MARKUP_RE = re.compile(
    r'<\|(?:object_ref_start|object_ref_end)\|>|</?(?:ref-object|object-ref|ref|object)>', re.IGNORECASE)
GROUNDING_PROMPT_RE = re.compile(
    r'\b(?:locate|localize|localise|localization|localisation|bounding[ _-]?box|bbox|coordinates?)\b',
    re.IGNORECASE)
BOX_KEYS = ('bbox_2d', 'bounding_box', 'bbox', 'box')
PREDICTION_COLUMNS = ('model', 'dataset', 'sample_id', 'line_number', 'task', 'question', 'reference', 'prediction',
                      'error', 'exact_match', 'vqa_accuracy', 'token_f1', 'rouge_l', 'bleu_4', 'chrf', 'pred_boxes',
