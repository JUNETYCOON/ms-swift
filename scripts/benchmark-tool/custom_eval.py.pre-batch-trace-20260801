class ScoreAccumulator:

    def __init__(self, iou_threshold: float) -> None:
        self.iou_threshold = iou_threshold
        self.vqa_samples = 0
        self.exact_sum = 0.0
        self.vqa_sum = 0.0
        self.vqa_token_f1_sum = 0.0
        self.description_samples = 0
        self.description_token_f1_sum = 0.0
        self.rouge_l_sum = 0.0
        self.bleu_4_sum = 0.0
        self.chrf_sum = 0.0
        self.grounding_samples = 0
        self.grounding_parse_success = 0
        self.gt_boxes = 0
        self.pred_boxes = 0
        self.matched_boxes = 0
        self.iou_sum = 0.0
        self.iou_hits = 0
        self.complete_samples = 0
        self.vqa_failed_samples = 0
        self.description_failed_samples = 0
        self.grounding_failed_samples = 0
        self.grounded_samples = 0
        self.grounded_description_token_f1_sum = 0.0
        self.grounded_rouge_l_sum = 0.0
        self.grounded_bleu_4_sum = 0.0
        self.grounded_chrf_sum = 0.0
        self.grounded_parse_success = 0
        self.grounded_gt_boxes = 0
        self.grounded_pred_boxes = 0
        self.grounded_matched_boxes = 0
        self.grounded_iou_sum = 0.0
        self.grounded_iou_hits = 0
        self.grounded_complete_samples = 0
        self.grounded_failed_samples = 0

    def add_vqa(self, scores: Mapping[str, float], failed: bool = False) -> None:
        self.vqa_samples += 1
        self.exact_sum += scores['exact_match']
        self.vqa_sum += scores['vqa_accuracy']
        self.vqa_token_f1_sum += scores['token_f1']
        self.vqa_failed_samples += int(failed)

    def add_description(self, scores: Mapping[str, float], failed: bool = False) -> None:
        self.description_samples += 1
        self.description_token_f1_sum += scores['token_f1']
        self.rouge_l_sum += scores['rouge_l']
        self.bleu_4_sum += scores['bleu_4']
        self.chrf_sum += scores['chrf']
        self.description_failed_samples += int(failed)

    def add_grounding(self, scores: Mapping[str, Any], failed: bool = False) -> None:
        self.grounding_samples += 1
        self.grounding_parse_success += int(scores['parse_success'])
        self.gt_boxes += int(scores['gt_box_count'])
        self.pred_boxes += int(scores['pred_box_count'])
        self.matched_boxes += int(scores['matched_box_count'])
        self.iou_sum += float(scores['iou_sum'])
        self.iou_hits += int(scores['iou_hits'])
        self.complete_samples += int(scores['complete'])
        self.grounding_failed_samples += int(failed)

    def add_grounded(self, description: Mapping[str, float], grounding: Mapping[str, Any],
                     failed: bool = False) -> None:
        self.grounded_samples += 1
        self.grounded_description_token_f1_sum += description['token_f1']
        self.grounded_rouge_l_sum += description['rouge_l']
        self.grounded_bleu_4_sum += description['bleu_4']
        self.grounded_chrf_sum += description['chrf']
        self.grounded_parse_success += int(grounding['parse_success'])
        self.grounded_gt_boxes += int(grounding['gt_box_count'])
        self.grounded_pred_boxes += int(grounding['pred_box_count'])
        self.grounded_matched_boxes += int(grounding['matched_box_count'])
        self.grounded_iou_sum += float(grounding['iou_sum'])
        self.grounded_iou_hits += int(grounding['iou_hits'])
        self.grounded_complete_samples += int(grounding['complete'])
        self.grounded_failed_samples += int(failed)

